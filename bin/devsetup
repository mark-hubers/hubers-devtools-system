#!/bin/zsh
# ============================================================================
# Mac Dev Setup - Main Command
# ============================================================================
# A smart tool manager for your Mac development environment
#
# Usage:
#   devsetup              - Interactive menu
#   devsetup check        - Show what's installed/missing
#   devsetup install      - Install all missing required tools
#   devsetup install-all  - Install ALL tools (including optional)
#   devsetup outdated     - Show outdated packages
#   devsetup update       - Update all packages
#   devsetup add <tool>   - Add a specific tool
#   devsetup remove <t>   - Remove a tool
#   devsetup search <q>   - Search for a tool
#   devsetup export       - Export your tool list
#   devsetup doctor       - Diagnose issues
#   devsetup categories   - List all categories
#   devsetup list <cat>   - List tools in a category
#
# ============================================================================

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Config
SCRIPT_DIR="${0:a:h:h}"  # Go up one level from bin/ to project root
TOOLS_FILE="${SCRIPT_DIR}/config/tools.yaml"
STATE_FILE="${HOME}/.config/mac-dev-setup/state.json"
LOG_FILE="${HOME}/.config/mac-dev-setup/install.log"

# Ensure config directory exists
mkdir -p "$(dirname "$STATE_FILE")"

# ============================================================================
# Helper Functions
# ============================================================================

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE"
}

print_header() {
    echo ""
    echo -e "${BOLD}${CYAN}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BOLD}${CYAN}║${NC}  ${BOLD}🚀 Mac Dev Setup${NC}                                           ${BOLD}${CYAN}║${NC}"
    echo -e "${BOLD}${CYAN}║${NC}     Smart tool management for your development environment   ${BOLD}${CYAN}║${NC}"
    echo -e "${BOLD}${CYAN}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

print_section() {
    echo ""
    echo -e "${BOLD}${BLUE}━━━ $1 ━━━${NC}"
    echo ""
}

success() {
    echo -e "${GREEN}✅ $1${NC}"
}

warning() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

error() {
    echo -e "${RED}❌ $1${NC}"
}

info() {
    echo -e "${CYAN}ℹ️  $1${NC}"
}

# Check if a command exists
cmd_exists() {
    command -v "$1" &> /dev/null
}

# Check if asdf is available and loaded
ensure_asdf() {
    if ! cmd_exists asdf; then
        # Try to load it
        if [[ -f "${BREW_PREFIX:-/opt/homebrew}/opt/asdf/libexec/asdf.sh" ]]; then
            . "${BREW_PREFIX:-/opt/homebrew}/opt/asdf/libexec/asdf.sh"
        elif [[ -f "$HOME/.asdf/asdf.sh" ]]; then
            . "$HOME/.asdf/asdf.sh"
        fi
    fi
    
    if ! cmd_exists asdf; then
        return 1
    fi
    return 0
}

# Install an asdf plugin if not already installed
install_asdf_plugin() {
    local plugin="$1"
    
    if ! ensure_asdf; then
        error "asdf is not installed. Run: devsetup add asdf"
        return 1
    fi
    
    if asdf plugin list 2>/dev/null | grep -q "^${plugin}$"; then
        echo "  Plugin '$plugin' already installed"
        return 0
    fi
    
    echo "  Adding asdf plugin: $plugin"
    asdf plugin add "$plugin" 2>/dev/null || {
        warning "Could not add plugin $plugin - trying with URL"
        # Some plugins need explicit URLs
        case "$plugin" in
            nodejs) asdf plugin add nodejs https://github.com/asdf-vm/asdf-nodejs.git ;;
            python) asdf plugin add python https://github.com/asdf-community/asdf-python.git ;;
            golang) asdf plugin add golang https://github.com/asdf-community/asdf-golang.git ;;
            terraform) asdf plugin add terraform https://github.com/asdf-community/asdf-hashicorp.git ;;
            kubectl) asdf plugin add kubectl https://github.com/asdf-community/asdf-kubectl.git ;;
            helm) asdf plugin add helm https://github.com/Antiarchitect/asdf-helm.git ;;
            awscli) asdf plugin add awscli https://github.com/MetricMike/asdf-awscli.git ;;
            *) return 1 ;;
        esac
    }
}

# Install a specific version via asdf
install_asdf_version() {
    local plugin="$1"
    local version="${2:-latest}"
    
    if ! ensure_asdf; then
        error "asdf is not installed"
        return 1
    fi
    
    echo "  Installing $plugin version: $version"
    
    if [[ "$version" == "latest" ]]; then
        asdf install "$plugin" latest 2>&1 | while read line; do echo "    $line"; done
        asdf global "$plugin" latest
    elif [[ "$version" == "lts" && "$plugin" == "nodejs" ]]; then
        # Special handling for Node.js LTS
        asdf install nodejs lts 2>&1 | while read line; do echo "    $line"; done
        asdf global nodejs lts
    else
        asdf install "$plugin" "$version" 2>&1 | while read line; do echo "    $line"; done
        asdf global "$plugin" "$version"
    fi
}

# Check if yq is installed (we need it to parse YAML)
ensure_yq() {
    if ! cmd_exists yq; then
        echo -e "${YELLOW}Installing yq (required to parse tool manifest)...${NC}"
        if cmd_exists brew; then
            brew install yq
        else
            error "Please install Homebrew first, then run this again"
            exit 1
        fi
    fi
}

# Parse tool from YAML
get_tools_in_category() {
    local category="$1"
    yq eval '.'$category'[].name' "$TOOLS_FILE" 2>/dev/null || echo ""
}

get_tool_field() {
    local category="$1"
    local name="$2"
    local field="$3"
    yq eval '.'$category'[] | select(.name == "'$name'") | .'$field "$TOOLS_FILE" 2>/dev/null || echo ""
}

get_all_categories() {
    yq eval 'keys | .[]' "$TOOLS_FILE" 2>/dev/null | grep -v "^version$" | grep -v "^last_updated$"
}

# Check if a tool is installed
check_tool_installed() {
    local category="$1"
    local name="$2"
    local check_cmd=$(get_tool_field "$category" "$name" "check")
    
    if [[ -z "$check_cmd" || "$check_cmd" == "null" ]]; then
        return 1
    fi
    
    eval "$check_cmd" &>/dev/null
    return $?
}

# ============================================================================
# Commands
# ============================================================================

cmd_check() {
    print_header
    print_section "Environment Check"
    
    ensure_yq
    
    local total=0
    local installed=0
    local missing_required=0
    local missing_optional=0
    
    for category in $(get_all_categories); do
        local cat_display=$(echo "$category" | tr '_' ' ' | sed 's/.*/\u&/')
        echo -e "${BOLD}${MAGENTA}▸ $cat_display${NC}"
        
        for tool in $(get_tools_in_category "$category"); do
            ((total++))
            local desc=$(get_tool_field "$category" "$tool" "description")
            local required=$(get_tool_field "$category" "$tool" "required")
            
            if check_tool_installed "$category" "$tool"; then
                ((installed++))
                echo -e "  ${GREEN}✅${NC} ${tool} ${CYAN}${desc:+- $desc}${NC}"
            else
                if [[ "$required" == "true" ]]; then
                    ((missing_required++))
                    echo -e "  ${RED}❌${NC} ${tool} ${YELLOW}[REQUIRED]${NC} ${CYAN}${desc:+- $desc}${NC}"
                else
                    ((missing_optional++))
                    echo -e "  ${YELLOW}○${NC}  ${tool} ${CYAN}${desc:+- $desc}${NC}"
                fi
            fi
        done
        echo ""
    done
    
    print_section "Summary"
    echo -e "Total tools:      ${BOLD}$total${NC}"
    echo -e "Installed:        ${GREEN}$installed${NC}"
    echo -e "Missing required: ${RED}$missing_required${NC}"
    echo -e "Missing optional: ${YELLOW}$missing_optional${NC}"
    echo ""
    
    if [[ $missing_required -gt 0 ]]; then
        warning "You have $missing_required required tools missing!"
        echo -e "Run ${BOLD}devsetup install${NC} to install them"
    else
        success "All required tools are installed!"
    fi
}

cmd_install() {
    print_header
    print_section "Installing Required Tools"
    
    ensure_yq
    
    local to_install=()
    
    # Collect missing required tools
    for category in $(get_all_categories); do
        for tool in $(get_tools_in_category "$category"); do
            local required=$(get_tool_field "$category" "$tool" "required")
            if [[ "$required" == "true" ]] && ! check_tool_installed "$category" "$tool"; then
                to_install+=("$category:$tool")
            fi
        done
    done
    
    if [[ ${#to_install[@]} -eq 0 ]]; then
        success "All required tools are already installed!"
        return 0
    fi
    
    echo "The following tools will be installed:"
    echo ""
    for item in "${to_install[@]}"; do
        local cat="${item%%:*}"
        local tool="${item#*:}"
        local desc=$(get_tool_field "$cat" "$tool" "description")
        echo -e "  • ${BOLD}$tool${NC} - $desc"
    done
    echo ""
    
    echo -n "Continue? (y/n) "
    read -k 1 REPLY
    echo ""

    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Cancelled."
        return 0
    fi
    
    for item in "${to_install[@]}"; do
        local cat="${item%%:*}"
        local tool="${item#*:}"
        install_tool "$cat" "$tool"
    done
    
    print_section "Installation Complete"
    success "All required tools have been installed!"
    echo ""
    info "Run 'devsetup check' to verify"
}

cmd_install_all() {
    print_header
    print_section "Installing ALL Tools"
    
    ensure_yq
    
    for category in $(get_all_categories); do
        for tool in $(get_tools_in_category "$category"); do
            if ! check_tool_installed "$category" "$tool"; then
                install_tool "$category" "$tool"
            fi
        done
    done
    
    success "All tools installed!"
}

install_tool() {
    local category="$1"
    local name="$2"
    
    echo ""
    echo -e "${BOLD}Installing: $name${NC}"
    log "Installing $name from category $category"
    
    local brew_pkg=$(get_tool_field "$category" "$name" "brew")
    local is_cask=$(get_tool_field "$category" "$name" "cask")
    local tap=$(get_tool_field "$category" "$name" "tap")
    local manual_install=$(get_tool_field "$category" "$name" "install_manual")
    local post_install=$(get_tool_field "$category" "$name" "post_install")
    local asdf_plugin=$(get_tool_field "$category" "$name" "asdf_plugin")
    local default_version=$(get_tool_field "$category" "$name" "default_version")
    
    # Handle asdf-managed tools
    if [[ "$category" == "asdf_tools" ]] || [[ -n "$asdf_plugin" && "$asdf_plugin" != "null" ]]; then
        if ! ensure_asdf; then
            error "asdf is not installed. Installing it first..."
            brew install asdf
            # Try to load it
            if [[ -f "$(brew --prefix)/opt/asdf/libexec/asdf.sh" ]]; then
                . "$(brew --prefix)/opt/asdf/libexec/asdf.sh"
            fi
        fi
        
        local plugin="${asdf_plugin:-$name}"
        install_asdf_plugin "$plugin" || {
            error "Failed to install asdf plugin: $plugin"
            return 1
        }
        
        local version="${default_version:-latest}"
        install_asdf_version "$plugin" "$version" || {
            error "Failed to install $plugin version $version"
            return 1
        }
        
        success "Installed: $name (via asdf, version: $version)"
        log "Successfully installed $name via asdf"
        return 0
    fi
    
    # Handle tap first if needed
    if [[ -n "$tap" && "$tap" != "null" ]]; then
        echo "  Adding tap: $tap"
        brew tap "$tap" 2>/dev/null || true
    fi
    
    # Install via Homebrew
    if [[ -n "$brew_pkg" && "$brew_pkg" != "null" ]]; then
        if [[ "$is_cask" == "true" ]]; then
            echo "  Installing cask: $brew_pkg"
            brew install --cask "$brew_pkg" 2>&1 | while read line; do echo "    $line"; done || true
        else
            echo "  Installing formula: $brew_pkg"
            brew install "$brew_pkg" 2>&1 | while read line; do echo "    $line"; done || true
        fi
    # Install via manual command
    elif [[ -n "$manual_install" && "$manual_install" != "null" ]]; then
        echo "  Running manual install..."
        echo "$manual_install" | while read cmd; do
            [[ -n "$cmd" ]] && eval "$cmd"
        done
    else
        warning "No install method found for $name"
        return 1
    fi
    
    # Run post-install commands
    if [[ -n "$post_install" && "$post_install" != "null" ]]; then
        echo "  Running post-install..."
        yq eval '.'$category'[] | select(.name == "'$name'") | .post_install[]' "$TOOLS_FILE" 2>/dev/null | while read cmd; do
            if [[ -n "$cmd" && "$cmd" != "null" ]]; then
                echo "    → $cmd"
                eval "$cmd" 2>&1 | while read line; do echo "      $line"; done || true
            fi
        done
    fi
    
    success "Installed: $name"
    log "Successfully installed $name"
}

cmd_outdated() {
    print_header
    print_section "Checking for Updates"
    
    echo "Checking Homebrew packages..."
    brew outdated
    
    echo ""
    echo "Checking Homebrew casks..."
    brew outdated --cask
    
    if cmd_exists asdf; then
        echo ""
        echo "Checking asdf plugins..."
        asdf plugin update --all 2>/dev/null || true
    fi
}

cmd_update() {
    print_header
    print_section "Updating All Packages"
    
    echo "Updating Homebrew..."
    brew update
    
    echo ""
    echo "Upgrading packages..."
    brew upgrade
    
    echo ""
    echo "Upgrading casks..."
    brew upgrade --cask
    
    echo ""
    echo "Cleaning up..."
    brew cleanup
    
    if cmd_exists asdf; then
        echo ""
        echo "Updating asdf plugins..."
        asdf plugin update --all
    fi
    
    success "All packages updated!"
}

cmd_add() {
    local tool="$1"
    
    if [[ -z "$tool" ]]; then
        error "Usage: devsetup add <tool-name>"
        return 1
    fi
    
    ensure_yq
    
    # Find the tool in the manifest
    for category in $(get_all_categories); do
        for t in $(get_tools_in_category "$category"); do
            if [[ "$t" == "$tool" ]]; then
                if check_tool_installed "$category" "$tool"; then
                    warning "$tool is already installed"
                    return 0
                fi
                install_tool "$category" "$tool"
                return 0
            fi
        done
    done
    
    error "Tool '$tool' not found in manifest"
    info "Use 'devsetup search $tool' to search, or add it to config/tools.yaml"
}

cmd_search() {
    local query="$1"
    
    if [[ -z "$query" ]]; then
        error "Usage: devsetup search <query>"
        return 1
    fi
    
    ensure_yq
    
    print_section "Search Results for '$query'"
    
    local found=0
    for category in $(get_all_categories); do
        for tool in $(get_tools_in_category "$category"); do
            local desc=$(get_tool_field "$category" "$tool" "description")
            if [[ "$tool" == *"$query"* ]] || [[ "${(L)desc}" == *"${(L)query}"* ]]; then
                ((found++))
                local indicator="○"
                local indicator_color="$YELLOW"
                if check_tool_installed "$category" "$tool"; then
                    indicator="✅"
                    indicator_color="$GREEN"
                fi
                echo -e "${indicator_color}${indicator}${NC} ${BOLD}$tool${NC} [$category]"
                echo -e "   $desc"
                echo ""
            fi
        done
    done
    
    if [[ $found -eq 0 ]]; then
        warning "No tools found matching '$query'"
        info "Check Homebrew: brew search $query"
    else
        info "Found $found tool(s)"
    fi
}

cmd_categories() {
    print_section "Available Categories"
    
    ensure_yq
    
    for category in $(get_all_categories); do
        local count=$(get_tools_in_category "$category" | wc -l | tr -d ' ')
        local cat_display=$(echo "$category" | tr '_' ' ')
        echo -e "  ${BOLD}$category${NC} ($count tools)"
    done
    
    echo ""
    info "Use 'devsetup list <category>' to see tools in a category"
}

cmd_list() {
    local category="$1"
    
    if [[ -z "$category" ]]; then
        cmd_categories
        return
    fi
    
    ensure_yq
    
    print_section "Tools in '$category'"
    
    for tool in $(get_tools_in_category "$category"); do
        local desc=$(get_tool_field "$category" "$tool" "description")
        local required=$(get_tool_field "$category" "$tool" "required")
        local indicator="○"
        local indicator_color="$YELLOW"

        if check_tool_installed "$category" "$tool"; then
            indicator="✅"
            indicator_color="$GREEN"
        fi

        local req_badge=""
        if [[ "$required" == "true" ]]; then
            req_badge="${RED}[required]${NC} "
        fi

        echo -e "${indicator_color}${indicator}${NC} ${BOLD}$tool${NC} $req_badge"
        echo -e "   $desc"
    done
}

cmd_doctor() {
    print_header
    print_section "System Diagnostics"
    
    echo "Checking system..."
    echo ""
    
    # Check macOS version
    echo -e "${BOLD}macOS Version:${NC}"
    sw_vers
    echo ""
    
    # Check shell
    echo -e "${BOLD}Current Shell:${NC} $SHELL"
    echo ""
    
    # Check Homebrew
    echo -e "${BOLD}Homebrew:${NC}"
    if cmd_exists brew; then
        brew --version | head -1
        echo "  Prefix: $(brew --prefix)"
        echo "  Checking health..."
        brew doctor 2>&1 | head -5
    else
        error "Homebrew not installed!"
    fi
    echo ""
    
    # Check PATH
    echo -e "${BOLD}PATH Check:${NC}"
    if [[ ":$PATH:" == *":/opt/homebrew/bin:"* ]]; then
        success "/opt/homebrew/bin is in PATH"
    else
        warning "/opt/homebrew/bin not in PATH (Apple Silicon)"
    fi
    
    if [[ ":$PATH:" == *":/usr/local/bin:"* ]]; then
        success "/usr/local/bin is in PATH"
    fi
    echo ""
    
    # Check oh-my-zsh
    echo -e "${BOLD}Oh-My-Zsh:${NC}"
    if [[ -d "$HOME/.oh-my-zsh" ]]; then
        success "Installed at ~/.oh-my-zsh"
    else
        warning "Not installed"
    fi
    echo ""
    
    # Check terminal config
    echo -e "${BOLD}ZSH Config:${NC}"
    if [[ -f "$HOME/.zshrc" ]]; then
        success "~/.zshrc exists ($(wc -l < ~/.zshrc | tr -d ' ') lines)"
    else
        warning "~/.zshrc not found"
    fi
}

cmd_export() {
    print_section "Exporting Tool List"
    
    ensure_yq
    
    local export_file="${HOME}/mac-dev-setup-export-$(date +%Y%m%d).txt"
    
    {
        echo "# Mac Dev Setup - Installed Tools Export"
        echo "# Generated: $(date)"
        echo "# ============================================"
        echo ""
        
        for category in $(get_all_categories); do
            echo "## $category"
            for tool in $(get_tools_in_category "$category"); do
                if check_tool_installed "$category" "$tool"; then
                    local brew_pkg=$(get_tool_field "$category" "$tool" "brew")
                    echo "$tool${brew_pkg:+ (brew: $brew_pkg)}"
                fi
            done
            echo ""
        done
    } > "$export_file"
    
    success "Exported to: $export_file"
}

cmd_versions() {
    print_header
    print_section "Installed Tool Versions"
    
    # Show asdf versions if available
    if ensure_asdf; then
        echo -e "${BOLD}${MAGENTA}▸ asdf-managed tools${NC}"
        echo ""
        asdf current 2>/dev/null | while read line; do
            echo "  $line"
        done
        echo ""
        
        echo -e "${CYAN}Tip: Change versions with:${NC}"
        echo "  asdf install <tool> <version>"
        echo "  asdf global <tool> <version>    # Set global default"
        echo "  asdf local <tool> <version>     # Set for current directory"
        echo ""
    else
        warning "asdf not installed - no version-managed tools"
    fi
    
    # Show Homebrew versions for key tools
    echo -e "${BOLD}${MAGENTA}▸ Homebrew tools${NC}"
    echo ""
    
    local brew_tools=("docker" "k9s" "kubectx" "lazygit" "fzf")
    for tool in "${brew_tools[@]}"; do
        if cmd_exists "$tool"; then
            local version=$("$tool" --version 2>/dev/null | head -1 || echo "installed")
            echo "  $tool: $version"
        fi
    done
}

cmd_asdf_update() {
    print_header
    print_section "Updating asdf Plugins"
    
    if ! ensure_asdf; then
        error "asdf is not installed"
        return 1
    fi
    
    echo "Updating all asdf plugins..."
    asdf plugin update --all
    
    echo ""
    echo "Current versions:"
    asdf current
    
    echo ""
    info "To upgrade a tool to latest:"
    echo "  asdf install <tool> latest"
    echo "  asdf global <tool> latest"
}

cmd_tool_versions() {
    print_header
    print_section "Generate .tool-versions File"
    
    if ! ensure_asdf; then
        error "asdf is not installed"
        return 1
    fi
    
    local output_file=".tool-versions"
    
    if [[ -f "$output_file" ]]; then
        warning "File $output_file already exists"
        echo -n "Overwrite? (y/n) "
        read -k 1 REPLY
        echo ""
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo "Cancelled"
            return 0
        fi
    fi
    
    echo "Generating $output_file with current global versions..."
    echo ""
    
    {
        echo "# Generated by devsetup on $(date)"
        echo "# This file pins tool versions for this project"
        echo ""
        asdf current 2>/dev/null | while read tool version rest; do
            if [[ -n "$tool" && -n "$version" && "$version" != "______" ]]; then
                echo "$tool $version"
            fi
        done
    } > "$output_file"
    
    echo "Created $output_file:"
    cat "$output_file"
    
    echo ""
    success "Done! Commit this file to pin versions for your project."
}

cmd_interactive() {
    print_header
    
    if ! cmd_exists fzf; then
        echo "Available commands:"
        echo ""
        echo "  devsetup check       - Show what's installed/missing"
        echo "  devsetup install     - Install all missing required tools"
        echo "  devsetup install-all - Install ALL tools (including optional)"
        echo "  devsetup outdated    - Show outdated packages"
        echo "  devsetup update      - Update all packages"
        echo "  devsetup add <tool>  - Add a specific tool"
        echo "  devsetup search <q>  - Search for a tool"
        echo "  devsetup categories  - List all categories"
        echo "  devsetup list <cat>  - List tools in a category"
        echo "  devsetup doctor      - Diagnose issues"
        echo "  devsetup export      - Export your tool list"
        echo ""
        return
    fi
    
    local options=(
        "check:Show what's installed and what's missing"
        "install:Install all missing required tools"
        "install-all:Install ALL tools (including optional)"
        "outdated:Show outdated packages"
        "update:Update all packages"
        "categories:List tool categories"
        "doctor:Diagnose system issues"
        "export:Export installed tools list"
    )
    
    local selection=$(printf '%s\n' "${options[@]}" | fzf --prompt="🚀 devsetup > " --height=50% --reverse --delimiter=: --with-nth=1 --preview='echo {2}')
    
    if [[ -n "$selection" ]]; then
        local cmd="${selection%%:*}"
        "cmd_$cmd"
    fi
}

cmd_help() {
    print_header
    echo "Usage: devsetup [command] [options]"
    echo ""
    echo "Commands:"
    echo "  check          Show what's installed and what's missing"
    echo "  install        Install all missing required tools"
    echo "  install-all    Install ALL tools (including optional)"
    echo "  add <tool>     Install a specific tool"
    echo "  remove <t>     Remove a tool (uses brew uninstall)"
    echo "  search <q>     Search for tools"
    echo ""
    echo "  outdated       Show outdated packages"
    echo "  update         Update all packages (brew + asdf)"
    echo "  sync           Sync shell config files (.d directories)"
    echo "  validate       Check for alias/function conflicts"
    echo ""
    echo "  versions       Show installed tool versions (asdf + brew)"
    echo "  asdf-update    Update all asdf plugins"
    echo "  tool-versions  Generate .tool-versions file for project"
    echo ""
    echo "  categories     List all tool categories"
    echo "  list <cat>     List tools in a category"
    echo "  doctor         Diagnose system issues"
    echo "  export         Export your tool list"
    echo "  test [name]    Run verification tests"
    echo "  help           Show this help"
    echo ""
    echo "Examples:"
    echo "  devsetup check                # See what's missing"
    echo "  devsetup install              # Install required tools"
    echo "  devsetup add k9s              # Install specific tool"
    echo "  devsetup add terraform        # Install via asdf (version-managed)"
    echo "  devsetup search kubernetes    # Find k8s tools"
    echo "  devsetup list asdf_tools      # List version-managed tools"
    echo "  devsetup versions             # Show all installed versions"
    echo "  devsetup test                 # Run all verification tests"
    echo "  devsetup test tools           # Run specific test category"
    echo ""
    echo "asdf Version Management:"
    echo "  After installing asdf_tools, manage versions with:"
    echo "    asdf list all <tool>        # See available versions"
    echo "    asdf install <tool> 1.5.7   # Install specific version"
    echo "    asdf global <tool> 1.5.7    # Set global default"
    echo "    asdf local <tool> 1.5.7     # Pin for current directory"
    echo ""
}

# ============================================================================
# Main
# ============================================================================

# ============================================================================
# Sync managed shell config files (.d directories)
# ============================================================================
cmd_sync() {
    print_header
    print_section "Syncing Shell Configuration"

    local src_dir="$SCRIPT_DIR/terminal-config/home/.zsh"
    local dest_dir="$HOME/.zsh"

    # Create directories if needed
    mkdir -p "$dest_dir"/{aliases.d,functions.d,path.d}

    local synced=0

    # Sync aliases.d
    if [[ -d "$src_dir/aliases.d" ]]; then
        for f in "$src_dir/aliases.d"/_devtools_*.zsh(N); do
            [[ -f "$f" ]] || continue
            cp "$f" "$dest_dir/aliases.d/"
            ((synced++))
        done
    fi

    # Sync functions.d
    if [[ -d "$src_dir/functions.d" ]]; then
        for f in "$src_dir/functions.d"/_devtools_*.zsh(N); do
            [[ -f "$f" ]] || continue
            cp "$f" "$dest_dir/functions.d/"
            ((synced++))
        done
    fi

    # Sync path.d
    if [[ -d "$src_dir/path.d" ]]; then
        for f in "$src_dir/path.d"/_devtools_*.zsh(N); do
            [[ -f "$f" ]] || continue
            cp "$f" "$dest_dir/path.d/"
            ((synced++))
        done
    fi

    # Create user template files if they don't exist
    for dir in aliases.d functions.d path.d; do
        local template="$dest_dir/$dir/my-custom.zsh"
        if [[ ! -f "$template" ]]; then
            cat > "$template" << 'EOF'
#!/bin/zsh
# ============================================================================
# My Custom Configuration
# ============================================================================
# This file is for YOUR personal customizations.
# It will NOT be overwritten by devsetup sync.
# Add your own aliases, functions, or PATH additions here.
# ============================================================================

EOF
            echo "  Created template: ~/${dir}/my-custom.zsh"
        fi
    done

    success "Synced $synced managed config files"
    echo ""
    echo "Managed files (_devtools_*) are updated by: devsetup sync"
    echo "Your files (my-custom.zsh) are never touched."
    echo ""
    echo "Reload your shell: source ~/.zshrc"
}

# ============================================================================
# Validate shell config for conflicts
# ============================================================================
cmd_validate() {
    print_header
    print_section "Validating Shell Configuration"
    echo ""

    local has_issues=0

    # Get all alias names
    local aliases=()
    local files=(
        "$HOME/.zshrc"
        "$HOME/.zsh/aliases.d"/*.zsh(N)
        "$HOME/.zsh"/*.zsh(N)
        "$HOME/.zsh/extensions.d"/*.zsh(N)
    )
    for f in "${files[@]}"; do
        [[ -f "$f" ]] && while read -r name; do
            [[ -n "$name" ]] && aliases+=("$name")
        done < <(grep -oE "^\s*alias\s+[a-zA-Z0-9_-]+=" "$f" 2>/dev/null | sed 's/.*alias\s*//' | sed 's/=//')
    done

    # Get all function names
    local functions=()
    local func_files=(
        "$HOME/.zshrc"
        "$HOME/.zsh/functions.d"/*.zsh(N)
        "$HOME/.zsh"/*.zsh(N)
        "$HOME/.zsh/extensions.d"/*.zsh(N)
    )
    for f in "${func_files[@]}"; do
        [[ -f "$f" ]] && while read -r name; do
            [[ -n "$name" ]] && functions+=("$name")
        done < <(grep -oE "^[a-zA-Z0-9_-]+\(\)" "$f" 2>/dev/null | sed 's/()//')
    done

    # Find conflicts (names that are both alias and function)
    local conflicts=()
    for alias_name in "${aliases[@]}"; do
        for func_name in "${functions[@]}"; do
            if [[ "$alias_name" == "$func_name" ]]; then
                conflicts+=("$alias_name")
            fi
        done
    done
    conflicts=($(printf '%s\n' "${conflicts[@]}" | sort -u))

    if [[ ${#conflicts[@]} -gt 0 ]]; then
        has_issues=1
        warning "Alias/function name conflicts detected!"
        echo ""
        echo "  These names are defined as BOTH alias AND function:"
        for name in "${conflicts[@]}"; do
            echo "    - $name"
        done
        echo ""
        echo "  This causes: 'defining function based on alias' error"
        echo ""
        echo "  Fix: Add 'unalias NAME 2>/dev/null' before the function"
        echo "  Find: grep -r 'alias $name=' ~/.zsh/"
        echo "        grep -r '^$name()' ~/.zsh/"
        echo ""
    else
        success "No alias/function conflicts"
    fi

    # Check for duplicate aliases
    local all_aliases=$(for f in "${files[@]}"; do
        [[ -f "$f" ]] && grep -oE "^\s*alias\s+[a-zA-Z0-9_-]+=" "$f" 2>/dev/null | sed 's/.*alias\s*//' | sed 's/=//'
    done)
    local duplicates=$(echo "$all_aliases" | sort | uniq -d)

    if [[ -n "$duplicates" ]]; then
        has_issues=1
        warning "Duplicate alias definitions!"
        echo ""
        echo "  These aliases are defined multiple times:"
        echo "$duplicates" | while read -r name; do
            [[ -n "$name" ]] && echo "    - $name"
        done
        echo ""
        echo "  Find: grep -r 'alias NAME=' ~/.zsh/"
        echo ""
    else
        success "No duplicate aliases"
    fi

    # Syntax check on config files
    local syntax_errors=0
    for f in "$HOME/.zsh/functions.d"/_devtools_*.zsh(N); do
        if ! zsh -n "$f" 2>/dev/null; then
            warning "Syntax error in: ${f/$HOME/~}"
            syntax_errors=1
        fi
    done
    for f in "$HOME/.zsh/aliases.d"/_devtools_*.zsh(N); do
        if ! zsh -n "$f" 2>/dev/null; then
            warning "Syntax error in: ${f/$HOME/~}"
            syntax_errors=1
        fi
    done

    if [[ $syntax_errors -eq 0 ]]; then
        success "All config files pass syntax check"
    else
        has_issues=1
    fi

    echo ""
    if [[ $has_issues -eq 0 ]]; then
        success "Shell configuration is valid!"
    else
        warning "Issues found - fix them to prevent shell startup errors"
    fi

    return $has_issues
}

main() {
    local cmd="${1:-}"
    shift 2>/dev/null || true

    case "$cmd" in
        "")              cmd_interactive ;;
        check)           cmd_check ;;
        install)         cmd_install ;;
        install-all)     cmd_install_all ;;
        outdated)        cmd_outdated ;;
        update)          cmd_update ;;
        sync)            cmd_sync ;;
        validate)        cmd_validate ;;
        add)             cmd_add "$@" ;;
        remove)          brew uninstall "$@" ;;
        search)          cmd_search "$@" ;;
        categories)      cmd_categories ;;
        list)            cmd_list "$@" ;;
        doctor)          cmd_doctor ;;
        export)          cmd_export ;;
        test)            "$SCRIPT_DIR/tests/test-runner.sh" "$@" ;;
        versions)        cmd_versions ;;
        asdf-update)     cmd_asdf_update ;;
        tool-versions)   cmd_tool_versions ;;
        help|--help|-h)  cmd_help ;;
        *)               error "Unknown command: $cmd"; cmd_help ;;
    esac
}

main "$@"
